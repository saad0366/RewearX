{
  "name": "rewearx-backend",
  "version": "1.0.0",
  "description": "ReWearX - AI-Powered Clothing Barter Platform Backend (Node.js + Express + MySQL)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:dev": "nodemon server.js",
    "dev": "nodemon server.js",
    "db:migrate": "mysql -u %DB_USER% -p%DB_PASSWORD% < scripts/migrate.sql",
    "db:seed": "node utils/seed.js",
    "create:admin": "node scripts/createAdmin.js",
    "db:sync:alter": "node utils/sync.js alter",
    "db:sync:force": "node utils/sync.js force"
  },
  "keywords": [
    "rewearx",
    "express",
    "mysql",
    "sequelize",
    "socket.io",
    "barter"
  ],
  "author": "Arsalan Saleem (SP23-BSE-070)",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.18.1",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "mysql2": "^3.11.4",
    "node-cron": "^4.6.0",
    "nodemailer": "^6.9.16",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "sequelize": "^6.37.5",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.3",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
